          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemIndex": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "price": {
          "type": "number"
        },
        "purchased": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
