        "name",
        "nameEn",
        "category",
        "unit",
        "price",
        "purchased",
        "createdAt",
        "updatedAt"
      ]
    },
    "WaterRecord": {
      "title": "WaterRecord",
      "description": "Monthly water usage (4 weeks), installment deposit, and payment tracking record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemIndex": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "week1": {
          "type": "number"
        },
        "week2": {
          "type": "number"
        },
        "week3": {
          "type": "number"
        },
        "week4": {
          "type": "number"
        },
        "amountPaid": {
          "type": "number"
        },
        "ratePerUnit": {
          "type": "number"
        },
        "depositOverride": {
          "type": "number"
        },
        "hasDepositOverride": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workbookId",
        "itemIndex",
        "name",
        "nameEn",
        "week1",
        "week2",
        "week3",
        "week4",
        "amountPaid",
        "ratePerUnit",
        "depositOverride",
        "hasDepositOverride",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/workbooks/{workbookId}": {
      "schema": { "$ref": "#/entities/Workbook" },
      "description": "Master financial workbook metadata document keyed by owner UID."
    },
    "/workbooks/{workbookId}/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/TenantRental" },
      "description": "Subcollection of rental property tenants and monthly rent amounts."
    },
    "/workbooks/{workbookId}/propertyExpenses/{expenseId}": {
      "schema": { "$ref": "#/entities/PropertyExpense" },
      "description": "Subcollection of shared and partner-specific property expenses."
    },
    "/workbooks/{workbookId}/ledgerEntries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Subcollection of Mesfin and Zewdnesh personal ledger entries."
    },
    "/workbooks/{workbookId}/groceries/{groceryId}": {
      "schema": { "$ref": "#/entities/GroceryItem" },
      "description": "Subcollection of grocery and consumable items."
    },
    "/workbooks/{workbookId}/waterRecords/{waterId}": {
      "schema": { "$ref": "#/entities/WaterRecord" },
      "description": "Subcollection of monthly water usage and installment payment records."
    }
  }
}
