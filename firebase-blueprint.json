{
  "entities": {
    "Workbook": {
      "title": "Workbook",
      "description": "Master financial workbook metadata owned by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the workbook owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "yearEC": {
          "type": "string",
          "description": "Ethiopian Calendar fiscal year label.",
          "minLength": 1,
          "maxLength": 40
        },
        "sourceFileName": {
          "type": "string",
          "description": "Source Excel or Markdown file name.",
          "minLength": 1,
          "maxLength": 120
        },
        "lastUpdated": {
          "type": "string",
          "description": "Human-readable last updated label.",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "yearEC",
        "sourceFileName",
        "lastUpdated",
        "createdAt",
        "updatedAt"
      ]
    },
    "TenantRental": {
      "title": "TenantRental",
      "description": "Individual tenant rental income record and partner split ratios across 12 Ethiopian months.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tenantNameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "splitLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "splitType": {
          "type": "string",
          "enum": ["50_50", "100_MESFIN", "100_ZEWDNESH", "CUSTOM_RATIO"],
          "maxLength": 32
        },
        "mesfinRatio": {
          "type": "number"
        },
        "zewdneshRatio": {
          "type": "number"
        },
        "m_meskerem": { "type": "number" },
        "m_tikimt": { "type": "number" },
        "m_hidar": { "type": "number" },
        "m_tahsas": { "type": "number" },
        "m_tir": { "type": "number" },
        "m_yekatit": { "type": "number" },
        "m_megabit": { "type": "number" },
        "m_miyazya": { "type": "number" },
        "m_ginbot": { "type": "number" },
        "m_sene": { "type": "number" },
        "m_hamle": { "type": "number" },
        "m_nehase": { "type": "number" },
        "sortOrder": { "type": "number" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workbookId",
        "tenantName",
        "tenantNameEn",
        "description",
        "splitLabel",
        "splitType",
        "mesfinRatio",
        "zewdneshRatio",
        "m_meskerem",
