    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Personal income, deposit, or expense record for Mesfin or Zewdnesh.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerType": {
          "type": "string",
          "enum": ["mesfinIncome", "mesfinExpenses", "zewdneshDeposits", "zewdneshExpenses"],
          "maxLength": 32
        },
        "dateOrMonth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
        "isPlaceholder": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workbookId",
        "ledgerType",
        "dateOrMonth",
        "description",
        "category",
        "amount",
        "isPlaceholder",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "GroceryItem": {
